# Copy to .env in this directory. .env is excluded from Git.
# Existing process environment values take precedence.
# OpenRouter serves both native Jev decisions and lexical model proposals.
OPENROUTER_API_KEY=
DS_DECISION_PROVIDER=openrouter
DS_LEXICAL_PROVIDER=openrouter
DS_LEXICAL_MODEL=deepseek/deepseek-v4.1-flash

# Optional alternative: direct TypeSafe. Set DS_DECISION_PROVIDER=typesafe.
# TYPESAFE_API_KEY=
